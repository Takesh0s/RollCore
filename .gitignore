# ------------------------------------------------------------------------------
# RollCore — .gitignore
# Monorepo: backend (Spring Boot) + web (React/Vite) + mobile (Expo / React Native)
# ------------------------------------------------------------------------------

# ── Dependências ──────────────────────────────────────────────────────────────
node_modules/

# ── Builds ────────────────────────────────────────────────────────────────────
dist/
dist-ssr/
.vite/
web-build/
*.tsbuildinfo
backend/target/
target/

# Maven Wrapper: manter versionado (não ignorar .mvn/, mvnw, mvnw.cmd)

# ── Mobile (Expo / React Native) ──────────────────────────────────────────────
.expo/
expo-env.d.ts
.kotlin/
.metro-health-check*
# pastas nativas geradas pelo Expo (prebuild) — não versionar
/ios
/android
/mobile/ios
/mobile/android

# ── Capacitor (web antigo) ────────────────────────────────────────────────────
android/build/
android/app/build/
android/.gradle/
android/local.properties
ios/App/build/
ios/Pods/
ios/.symlinks/

# ── Variáveis de ambiente / config local ──────────────────────────────────────
.env
.env.*
!.env.example
*.local

# ── Segredos e certificados ───────────────────────────────────────────────────
*.pem
*.jks
*.p8
*.p12
*.key
*.keystore
*.mobileprovision
*.orig.*

# ── Vercel ────────────────────────────────────────────────────────────────────
.vercel/

# ── Playwright (E2E) ──────────────────────────────────────────────────────────
playwright-report/
test-results/
blob-report/
/playwright/.cache/
/playwright/.auth/

# ── Cobertura (JaCoCo) ────────────────────────────────────────────────────────
backend/target/site/jacoco/
jacoco.exec
*.exec

# ── Docker ────────────────────────────────────────────────────────────────────
# overrides locais nunca vão para o repositório
docker-compose.override.yml

# ── Logs e arquivos de execução ───────────────────────────────────────────────
*.log
logs/
backend/logs/
spring.pid
spring.log
npm-debug.*
yarn-debug.*
yarn-error.*

# ── IDEs / Editores ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Sistema operacional ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Arquivos temporários internos ─────────────────────────────────────────────
texto.txt
commits.sh
