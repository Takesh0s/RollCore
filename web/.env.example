# API base URL (defaults to http://localhost:8080 when unset).
# To test from a phone on the same Wi-Fi, use VITE_API_URL=/api in .env.local
# and run `npm run dev -- --host` (the dev server proxies /api to the backend).
VITE_API_URL=http://localhost:8080

# OAuth client id of the "Web application" credential (public, not a secret).
# Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
