        UUID id PK
        UUID game_table_id FK
        UUID user_id FK
        VARCHAR role
    }
    TABLE_EVENTS {
        UUID id PK
        UUID game_table_id FK
        UUID created_by FK
        DATE event_date
    }
    TABLE_EVENT_RSVPS {
        UUID id PK
        UUID event_id FK
        UUID user_id FK
        VARCHAR status
    }
    IMAGES {
        UUID id PK
        UUID owner_id FK
