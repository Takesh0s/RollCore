# URL of the RollCore API (no trailing slash). Inlined at build time by Expo.
# Android emulator -> your PC:  http://10.0.2.2:8080
# Physical device on Wi-Fi:      http://<your-PC-LAN-IP>:8080   (cleartext HTTP only works in dev builds)
# Production (Render):           https://<your-service>.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:8080

# Google sign-in (public OAuth client ids, not secrets). Leave empty to keep the button disabled.
# Web client: used by `expo start --web` / the web build.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Android client: only for development/production builds (never Expo Go). Needs package + SHA-1.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
