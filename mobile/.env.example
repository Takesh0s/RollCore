# URL of the RollCore API (no trailing slash). Inlined at build time by Expo.
# Android emulator -> your PC:  http://10.0.2.2:8080
# Physical device on Wi-Fi:      http://<your-PC-LAN-IP>:8080   (cleartext HTTP only works in dev builds)
# Production (Render):           https://<your-service>.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:8080
