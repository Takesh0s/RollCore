    {
      "name": "Delete all and create the first user",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const postRequest = {",
              "    url: 'http://localhost:8080/auth/deleteall',",
              "    method: 'DELETE',",
              "    header: {",
              "        \"Authorization\": \"Bearer \" + pm.collectionVariables.get(\"Secret\")",
              "}",
              "};",
              "",
              "pm.sendRequest(postRequest, (error, response) => {",
              "  console.log(error ? error : response.json());",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "pm.test(\"Status code is 201\", function () {",
              "    if (pm.response.code == \"201\") {",
              "        console.log(jsonData.accessToken);",
              "        pm.collectionVariables.set(\"Secret\", jsonData.accessToken);",
              "    }",
              "    console.log(pm.response.code)",
              "    console.log(jsonData.accessToken);",
              "    console.log(pm.collectionVariables.get(\"Secret\"))",
              "    pm.response.to.have.status(201);",
              "    ",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
